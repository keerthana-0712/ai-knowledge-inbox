# ==============================================================================
# AI Knowledge Inbox - Environment Configuration
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Configuration
DATABASE_PATH=./data/knowledge_inbox.db

# AI Integration Configuration (OpenAI or Compatible Provider)
# Set your OpenAI API key to enable text-embedding-3-small and gpt-4o-mini
# If left blank, the application automatically runs in deterministic local vector mode
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Chunking Configuration
CHUNK_SIZE=600
CHUNK_OVERLAP=100
MAX_RETRIEVAL_CHUNKS=5
MIN_SIMILARITY_THRESHOLD=0.15
